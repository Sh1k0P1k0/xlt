# XLT's USB sync link (plugin/xltsync): lets the logged-in user talk to the PSP
# without root. Install:
#   sudo install -m 644 tools/60-xltsync.rules /etc/udev/rules.d/
#   sudo udevadm control --reload
# then unplug and replug the PSP.
SUBSYSTEM=="usb", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="01cb", TAG+="uaccess"
